{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:cross-source-analysis-plan:v1",
  "title": "Google Analytics Advisor immutable cross-source analysis plan",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "planId", "planSha256", "projectRoot", "request", "sources", "analyses", "expectedDatasets", "periods", "boundaryAlignment", "mappingPolicy", "rowBounds", "blockers", "limitations", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1}, "artifactType": {"const": "cross-source-analysis-plan"}, "generatedAt": {"type": "string", "format": "date-time"},
    "planId": {"type": "string", "pattern": "^cross-source-plan-[A-Za-z0-9._-]{8,140}$"}, "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projectRoot": {"type": "string", "minLength": 3}, "request": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}, "analyses": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["overview-handoff", "landing-opportunities", "device-context"]}},
    "expectedDatasets": {"type": "array", "items": {"type": "string"}}, "periods": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "boundaryAlignment": {"enum": ["exact", "date_labels_only"]}, "mappingPolicy": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "rowBounds": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}, "blockers": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "networkUsed": {"const": false}, "mutationPerformed": {"const": false}
  }
}

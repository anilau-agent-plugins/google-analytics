{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:gtm-change-request:v1",
  "title": "Google Analytics Advisor GTM change request",
  "$defs": {
    "safeValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "propertyNames": {"pattern": "^(?!.*(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])(?:[Vv][Aa][Ll][Uu][Ee])?$).*$"}, "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "entityKind", "template", "name", "settings"],
      "properties": {
        "action": {"enum": ["create", "update", "pause"]},
        "entityKind": {"enum": ["variable", "trigger", "tag"]},
        "template": {"enum": ["data-layer-variable", "custom-event-trigger", "page-view-trigger", "history-change-trigger", "google-tag", "ga4-event-tag"]},
        "name": {"type": "string", "minLength": 1},
        "entityPath": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "settings": {"type": "object", "$ref": "#/$defs/safeValue"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "projectRoot", "profileId", "container", "stage", "rationale"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "gtm-change-request"},
    "projectRoot": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "container": {"type": "string", "pattern": "^accounts/[A-Za-z0-9_-]+/containers/[A-Za-z0-9_-]+$"},
    "stage": {"enum": ["WORKSPACE_CREATE", "WORKSPACE_SYNC", "ENTITY_BULK_UPDATE", "QUICK_PREVIEW", "VERSION_CREATE", "PUBLISH"]},
    "rationale": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "pattern": "^accounts/[A-Za-z0-9_-]+/containers/[A-Za-z0-9_-]+/workspaces/[A-Za-z0-9_-]+$"},
    "workspaceName": {"type": "string", "minLength": 1},
    "workspaceDescription": {"type": "string"},
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "evidenceJournal": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^accounts/[A-Za-z0-9_-]+/containers/[A-Za-z0-9_-]+/versions/[A-Za-z0-9_-]+$"},
    "versionFingerprint": {"type": "string", "minLength": 1},
    "versionName": {"type": "string", "minLength": 1},
    "versionNotes": {"type": "string"},
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "observedAt", "container", "checks"],
      "properties": {
        "confirmed": {"const": true},
        "observedAt": {"type": "string", "format": "date-time"},
        "container": {"type": "string", "pattern": "^accounts/[A-Za-z0-9_-]+/containers/[A-Za-z0-9_-]+$"},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}

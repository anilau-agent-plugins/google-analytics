{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:advisor-assessment-checkpoint:v1",
  "title": "Google Analytics Advisor immutable full-picture checkpoint",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "checkpointId", "checkpointSha256", "sequence", "projectRoot", "requestId", "planId", "planSha256", "previousCheckpoint", "identities", "periods", "steps", "domains", "budget", "status", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "advisor-assessment-checkpoint"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "checkpointId": {"type": "string", "pattern": "^advisor-checkpoint-[A-Za-z0-9._-]{8,140}$"},
    "checkpointSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "projectRoot": {"type": "string", "minLength": 3},
    "requestId": {"type": "string", "minLength": 8},
    "planId": {"type": "string", "minLength": 8},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previousCheckpoint": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/safe"}},
    "identities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "periods": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "steps": {"type": "array", "minItems": 5, "maxItems": 6, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "domains": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "budget": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "status": {"enum": ["running", "partial", "ready", "blocked"]},
    "networkUsed": {"type": "boolean"},
    "mutationPerformed": {"const": false}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:report-plan:v1",
  "title": "Google Analytics Advisor immutable report plan",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "expiresAt", "planId", "planSha256", "projectRoot", "profileId", "property", "request", "metadata", "propertyContext", "periods", "queries", "blockers", "limitations", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1}, "artifactType": {"const": "report-plan"},
    "generatedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "planId": {"type": "string", "pattern": "^report-plan-[A-Za-z0-9._-]{8,140}$"}, "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projectRoot": {"type": "string", "minLength": 3}, "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"}, "property": {"type": "string", "pattern": "^properties/[0-9]+$"},
    "request": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["contentSha256", "requestId", "discoveryRevision", "dimensions", "metrics"], "properties": {"contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "requestId": {"type": ["string", "null"]}, "discoveryRevision": {"type": "string", "minLength": 1}, "dimensions": {"type": "array", "items": {"type": "string"}}, "metrics": {"type": "array", "items": {"type": "string"}}}},
    "propertyContext": {"type": "object", "additionalProperties": false, "required": ["timeZone", "currencyCode", "baselineRef", "measurementPlanRef", "qualityTier", "language"], "properties": {"timeZone": {"type": "string", "minLength": 1}, "currencyCode": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}, "baselineRef": {"type": ["string", "null"]}, "measurementPlanRef": {"type": ["string", "null"]}, "qualityTier": {"enum": ["descriptive", "business-context"]}, "language": {"enum": ["auto", "ru", "en"]}, "webStream": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/safe"}}}},
    "periods": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["label", "from", "to", "complete"], "properties": {"label": {"enum": ["current", "previous", "previous-year"]}, "from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}, "complete": {"type": "boolean"}}}},
    "queries": {"type": "array", "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["queryId", "preset", "operationId", "apiChannel", "payload", "maxPages", "maxRows", "compatibility"], "properties": {"queryId": {"type": "string", "pattern": "^query-[a-z0-9-]{3,80}$"}, "preset": {"type": "string", "minLength": 1}, "operationId": {"enum": ["data.report.run", "data.report.realtime", "data.report.funnel"]}, "apiChannel": {"enum": ["v1beta", "v1alpha"]}, "payload": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}, "maxPages": {"type": "integer", "minimum": 1, "maximum": 4}, "maxRows": {"type": "integer", "minimum": 1, "maximum": 1000}, "compatibility": {"enum": ["compatible", "closed-registry", "experimental-contract"]}}}},
    "blockers": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}},
    "networkUsed": {"const": true}, "mutationPerformed": {"const": false}
  }
}

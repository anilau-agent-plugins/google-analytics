{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:baseline-report:v1",
  "title": "Google Analytics Advisor read-only baseline report",
  "$defs": {
    "safeValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "propertyNames": {"pattern": "^(?!.*(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])(?:[Vv][Aa][Ll][Uu][Ee])?$).*$"}, "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "auditId", "profileRef", "projectRoot", "targets", "scope", "completeness", "snapshots", "facts", "findings", "limitations", "recommendations", "questions", "requestEvidence", "partial", "truncated", "experimental"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "baseline-report"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "auditId": {"type": "string", "pattern": "^baseline-[A-Za-z0-9-]{12,128}$"},
    "profileRef": {"type": "string", "minLength": 1},
    "projectRoot": {"type": "string", "minLength": 1},
    "targets": {"$ref": "#/$defs/safeValue"},
    "scope": {"$ref": "#/$defs/safeValue"},
    "completeness": {"enum": ["complete", "partial"]},
    "snapshots": {"type": "array", "items": {"$ref": "#/$defs/safeValue"}, "minItems": 2},
    "facts": {"$ref": "#/$defs/safeValue"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "requestEvidence": {"$ref": "#/$defs/safeValue"},
    "partial": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "experimental": {"type": "boolean"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:search-console-inspection-request:v1",
  "title": "Google Analytics Advisor Search Console URL Inspection request",
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "url": {"type": "object", "additionalProperties": false, "required": ["url", "reason", "sourceKind", "evidenceRef", "sourceArtifact"], "properties": {"url": {"type": "string", "minLength": 8}, "reason": {"type": "string", "minLength": 3}, "sourceKind": {"enum": ["user", "search-console-performance", "local-project", "business-context"]}, "evidenceRef": {"type": ["string", "null"]}, "sourceArtifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}}}
  },
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "createdAt", "requestId", "contentSha256", "projectRoot", "profileId", "site", "question", "language", "providerLanguageCode", "sitemapSnapshotRef", "urls", "requestedBudget"],
  "properties": {
    "schemaVersion": {"const": 1}, "artifactType": {"const": "search-console-inspection-request"}, "createdAt": {"type": "string", "format": "date-time"},
    "requestId": {"type": "string", "pattern": "^search-console-inspection-request-[A-Za-z0-9._-]{4,140}$"}, "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projectRoot": {"type": "string", "minLength": 3}, "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"}, "site": {"type": "string", "minLength": 4},
    "question": {"type": "string", "minLength": 3}, "language": {"enum": ["ru", "en"]}, "providerLanguageCode": {"enum": ["ru-RU", "en-US"]},
    "sitemapSnapshotRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "urls": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/url"}},
    "requestedBudget": {"type": "object", "additionalProperties": false, "required": ["maxUrls"], "properties": {"maxUrls": {"type": "integer", "minimum": 1, "maximum": 10}}}
  }
}

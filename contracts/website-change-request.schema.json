{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:website-change-request:v1",
  "title": "Google Analytics Advisor website change request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "projectRoot", "contextId", "contextSha256", "measurementPlanId", "measurementPlanSha256", "route", "intents", "verificationCommands", "networkAllowed", "deploymentApproved"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "website-change-request"},
    "projectRoot": {"type": "string", "minLength": 1},
    "contextId": {"type": "string", "minLength": 1},
    "contextSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "measurementPlanId": {"type": "string", "minLength": 1},
    "measurementPlanSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "route": {"enum": ["direct", "gtm"]},
    "intents": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "verificationCommands": {"type": "array", "items": {"type": "object"}},
    "networkAllowed": {"const": false},
    "deploymentApproved": {"const": false}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:report:v2",
  "title": "Google Analytics Advisor report",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "reportId", "property", "timezone", "currency", "periods", "queries", "facts", "calculations", "interpretations", "limitations", "recommendations", "questions"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]}, "artifactType": {"const": "report"},
    "generatedAt": {"type": "string", "format": "date-time"}, "reportId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,160}$"},
    "reportSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"},
    "property": {"type": "string", "pattern": "^properties/[0-9]+$"}, "timezone": {"type": "string", "minLength": 1}, "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "status": {"enum": ["ready", "partial", "empty", "insufficient_data", "blocked", "failed"]}, "qualityTier": {"enum": ["reliable_for_description", "directional_only", "insufficient", "diagnostic_only"]},
    "periods": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["label", "from", "to", "complete"], "properties": {"label": {"type": "string", "minLength": 1}, "from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}, "complete": {"type": "boolean"}}}},
    "propertyContext": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "datasets": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "queries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "calculations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "interpretations": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
    "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "recommendations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "questions": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:search-console-sitemap-snapshot:v1",
  "title": "Google Analytics Advisor Search Console sitemap snapshot",
  "$defs": {
    "safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]},
    "content": {"type": "object", "additionalProperties": false, "required": ["type", "submitted"], "properties": {"type": {"type": ["string", "null"]}, "submitted": {"type": "integer", "minimum": 0}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "type", "isPending", "isSitemapsIndex", "lastSubmitted", "lastDownloaded", "warnings", "errors", "contents"], "properties": {"path": {"type": "string", "minLength": 1}, "type": {"type": ["string", "null"]}, "isPending": {"type": "boolean"}, "isSitemapsIndex": {"type": "boolean"}, "lastSubmitted": {"type": ["string", "null"]}, "lastDownloaded": {"type": ["string", "null"]}, "warnings": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}, "contents": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/content"}}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "snapshotId", "snapshotSha256", "projectRoot", "profileId", "credentialFingerprint", "site", "propertyIdentity", "mode", "requestedSitemapIndex", "requestedSitemap", "entries", "totals", "limitations", "requestLedger", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1}, "artifactType": {"const": "search-console-sitemap-snapshot"},
    "generatedAt": {"type": "string", "format": "date-time"}, "snapshotId": {"type": "string", "pattern": "^search-console-sitemap-[A-Za-z0-9._-]{8,140}$"},
    "snapshotSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "projectRoot": {"type": "string", "minLength": 3},
    "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"}, "credentialFingerprint": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "site": {"type": "string", "minLength": 4}, "propertyIdentity": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "mode": {"enum": ["root-list", "index-list", "get"]}, "requestedSitemapIndex": {"type": ["string", "null"]}, "requestedSitemap": {"type": ["string", "null"]},
    "entries": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/entry"}}, "totals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}}, "requestLedger": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "networkUsed": {"const": true}, "mutationPerformed": {"const": false}
  }
}

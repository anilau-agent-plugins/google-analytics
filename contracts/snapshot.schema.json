{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:snapshot:v1",
  "title": "Google Analytics Advisor immutable snapshot",
  "$defs": {
    "safeValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "propertyNames": {"pattern": "^(?!.*(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])(?:[Vv][Aa][Ll][Uu][Ee])?$).*$"}, "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "snapshotId", "provider", "apiChannel", "resource", "stateSha256", "state", "requestIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "snapshot"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "snapshotId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "provider": {"enum": ["analytics-admin", "analytics-data", "tag-manager", "website"]},
    "apiChannel": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1},
    "stateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"type": "object", "$ref": "#/$defs/safeValue"},
    "requestIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}

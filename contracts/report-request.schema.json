{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:report-request:v1",
  "title": "Google Analytics Advisor report request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "createdAt", "requestId", "projectRoot", "profileId", "property", "question", "language", "period", "comparisons", "presets", "includeToday", "experimentalFunnel", "alphaDisclosureAccepted", "contentSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "report-request"},
    "createdAt": {"type": "string", "format": "date-time"},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "projectRoot": {"type": "string", "minLength": 3},
    "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"},
    "property": {"type": "string", "pattern": "^properties/[0-9]+$"},
    "question": {"type": "string", "minLength": 3},
    "language": {"enum": ["auto", "ru", "en"]},
    "period": {"type": "object", "additionalProperties": false, "required": ["mode", "days", "from", "to"], "properties": {"mode": {"enum": ["last-complete-days", "explicit"]}, "days": {"type": ["integer", "null"], "minimum": 1, "maximum": 366}, "from": {"type": ["string", "null"], "format": "date"}, "to": {"type": ["string", "null"], "format": "date"}}},
    "comparisons": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"enum": ["previous-period", "previous-year"]}},
    "presets": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 12, "items": {"enum": ["overview", "acquisition", "user-acquisition", "landing", "content", "device", "geo", "events", "key-events", "ecommerce", "realtime", "funnel-experimental", "custom-core"]}},
    "includeToday": {"type": "boolean"},
    "experimentalFunnel": {"type": "boolean"},
    "alphaDisclosureAccepted": {"type": "boolean"},
    "baselineRef": {"type": ["string", "null"]},
    "measurementPlanRef": {"type": ["string", "null"]},
    "customCore": {"type": ["object", "null"], "additionalProperties": false, "required": ["dimensions", "metrics", "filters", "rowLimit"], "properties": {"dimensions": {"type": "array", "uniqueItems": true, "maxItems": 3, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"}}, "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:]{0,119}$"}}, "filters": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["fieldName", "values"], "properties": {"fieldName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"}, "values": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}}}}}, "rowLimit": {"type": "integer", "minimum": 1, "maximum": 1000}}},
    "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

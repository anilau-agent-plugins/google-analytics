{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:advisor-assessment-report:v1",
  "title": "Google Analytics Advisor full-picture report",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "reportId", "reportSha256", "requestId", "planId", "projectRoot", "language", "status", "qualityTier", "identities", "periods", "sources", "domains", "diagnosis", "confidence", "facts", "calculations", "interpretations", "findings", "limitations", "recommendations", "questions", "safeNextStep", "latestCheckpoint", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "advisor-assessment-report"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "reportId": {"type": "string", "pattern": "^advisor-report-[A-Za-z0-9._-]{8,140}$"},
    "reportSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requestId": {"type": "string", "minLength": 8},
    "planId": {"type": "string", "minLength": 8},
    "projectRoot": {"type": "string", "minLength": 3},
    "language": {"enum": ["ru", "en"]},
    "status": {"enum": ["ready", "partial", "blocked", "empty"]},
    "qualityTier": {"enum": ["reliable_for_description", "directional_only", "insufficient"]},
    "identities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "periods": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "domains": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "diagnosis": {"type": "string", "minLength": 3},
    "confidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "calculations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "interpretations": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "recommendations": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "questions": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "safeNextStep": {"type": "string", "minLength": 3},
    "latestCheckpoint": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "networkUsed": {"type": "boolean"},
    "mutationPerformed": {"const": false}
  }
}

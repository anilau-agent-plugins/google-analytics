{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:search-console-report-plan:v1",
  "title": "Google Analytics Advisor immutable Search Console report plan",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "expiresAt", "planId", "planSha256", "projectRoot", "profileId", "credentialFingerprint", "site", "propertyIdentity", "request", "periods", "queries", "budget", "blockers", "limitations", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "search-console-report-plan"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "planId": {"type": "string", "pattern": "^search-console-report-plan-[A-Za-z0-9._-]{8,140}$"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projectRoot": {"type": "string", "minLength": 3},
    "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"},
    "credentialFingerprint": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "site": {"type": "string", "minLength": 4},
    "propertyIdentity": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "request": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "periods": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "queries": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "budget": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "networkUsed": {"const": true},
    "mutationPerformed": {"const": false}
  }
}

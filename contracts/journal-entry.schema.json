{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:journal-entry:v1",
  "title": "Google Analytics Advisor mutation journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "journalId", "planId", "planSha256", "confirmationSha256", "startedAt", "finishedAt", "status", "requestIds", "readback"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "artifactType": {"const": "journal-entry"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "journalId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "planId": {"type": "string", "minLength": 8},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confirmationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["applied", "no_op", "partial", "ambiguous", "failed", "blocked"]},
    "requestIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "observedStateSha256", "message"],
      "properties": {
        "verified": {"type": "boolean"},
        "observedStateSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "operations": {"type": "array", "items": {"type": "object"}},
    "projectRoot": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "planPath": {"type": "string", "minLength": 1}
  }
}

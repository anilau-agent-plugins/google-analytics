{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:cross-source-analysis-report:v1",
  "title": "Google Analytics Advisor cross-source analysis report",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "reportId", "reportSha256", "status", "qualityTier", "sources", "periods", "boundaryAlignment", "mappingSummary", "pageMappings", "deviceMappings", "facts", "calculations", "interpretations", "findings", "limitations", "recommendations", "questions", "safeNextStep", "networkUsed", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1}, "artifactType": {"const": "cross-source-analysis-report"}, "generatedAt": {"type": "string", "format": "date-time"},
    "reportId": {"type": "string", "pattern": "^cross-source-report-[A-Za-z0-9._-]{8,140}$"}, "reportSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["ready", "partial", "empty", "blocked"]}, "qualityTier": {"enum": ["reliable_for_description", "directional_only", "insufficient"]},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}, "periods": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}, "boundaryAlignment": {"enum": ["exact", "date_labels_only"]},
    "mappingSummary": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}, "pageMappings": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}}, "deviceMappings": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}}, "calculations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}}, "interpretations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}}, "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "recommendations": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}}, "questions": {"type": "array", "items": {"type": "string"}}, "safeNextStep": {"type": "string", "minLength": 3},
    "networkUsed": {"const": false}, "mutationPerformed": {"const": false}
  }
}

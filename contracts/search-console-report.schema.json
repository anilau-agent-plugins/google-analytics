{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:search-console-report:v1",
  "title": "Google Analytics Advisor Search Console report",
  "$defs": {"safe": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"$ref": "#/$defs/safe"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}]}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "reportId", "reportSha256", "profileId", "site", "propertyIdentity", "timezone", "status", "qualityTier", "periods", "datasets", "queries", "budget", "facts", "calculations", "interpretations", "limitations", "recommendations", "questions", "mutationPerformed"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "search-console-report"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "reportId": {"type": "string", "pattern": "^search-console-report-[A-Za-z0-9._-]{8,140}$"},
    "reportSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profileId": {"type": "string", "pattern": "^profile-[a-f0-9]{16}$"},
    "site": {"type": "string", "minLength": 4},
    "propertyIdentity": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "timezone": {"const": "America/Los_Angeles"},
    "status": {"enum": ["ready", "partial", "empty", "failed"]},
    "qualityTier": {"enum": ["reliable_for_description", "directional_only", "preliminary", "insufficient"]},
    "periods": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "datasets": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "queries": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "budget": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "calculations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "interpretations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "recommendations": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe"}}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "mutationPerformed": {"const": false}
  }
}

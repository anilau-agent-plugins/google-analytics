{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:project-profile:v1",
  "title": "Google Analytics Advisor project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "project", "website", "analytics", "businessContext"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "project-profile"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "language"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "root": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "credentialRef": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:/-]+$"}
      }
    },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "stack", "productionDeployAuthorized"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "stack": {"type": ["string", "null"]},
        "productionDeployAuthorized": {"const": false}
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "property", "webStream", "gtm"],
      "properties": {
        "account": {"type": ["string", "null"], "pattern": "^accounts/[0-9]+$"},
        "property": {"type": ["string", "null"], "pattern": "^properties/[0-9]+$"},
        "webStream": {"type": ["string", "null"], "pattern": "^properties/[0-9]+/dataStreams/[0-9]+$"},
        "gtm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["accountPath", "containerPath"],
          "properties": {
            "accountPath": {"type": "string", "pattern": "^accounts/[0-9]+$"},
            "containerPath": {"type": "string", "pattern": "^accounts/[0-9]+/containers/[0-9]+$"}
          }
        }
      }
    },
    "businessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "currency", "outcomes", "confirmedByUser"],
      "properties": {
        "timezone": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "confirmedByUser": {"type": "boolean"}
      }
    }
  }
}

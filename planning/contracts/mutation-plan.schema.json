{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:mutation-plan:v1",
  "title": "Google Analytics Advisor immutable mutation plan",
  "$defs": {
    "safeValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "propertyNames": {"pattern": "^(?!.*(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])(?:[Vv][Aa][Ll][Uu][Ee])?$).*$"}, "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"target": {"const": "website"}}, "required": ["target"]},
      "then": {"properties": {
        "riskClass": {"const": "LOCAL_CODE_CHANGE"},
        "operations": {"items": {"properties": {"method": {"const": "FILE_PATCH"}}}}
      }}
    },
    {
      "if": {"properties": {"target": {"const": "analytics-admin"}}, "required": ["target"]},
      "then": {"properties": {
        "riskClass": {"const": "REMOTE_CONFIG_CHANGE"},
        "operations": {"items": {"properties": {"method": {"enum": ["POST", "PATCH", "PUT"]}}}}
      }}
    },
    {
      "if": {"properties": {"target": {"const": "tag-manager"}}, "required": ["target"]},
      "then": {"properties": {
        "riskClass": {"enum": ["REMOTE_CONFIG_CHANGE", "GTM_VERSION_CREATE", "GTM_PUBLISH"]},
        "operations": {"items": {"properties": {"method": {"enum": ["POST", "PATCH", "PUT"]}}}}
      }}
    }
  ],
  "required": ["schemaVersion", "artifactType", "generatedAt", "expiresAt", "planId", "planSha256", "target", "riskClass", "preconditions", "operations", "expectedReadback"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "mutation-plan"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "planId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {"enum": ["analytics-admin", "tag-manager", "website"]},
    "riskClass": {"enum": ["LOCAL_CODE_CHANGE", "REMOTE_CONFIG_CHANGE", "GTM_VERSION_CREATE", "GTM_PUBLISH"]},
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "snapshotId", "stateSha256"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "snapshotId": {"type": "string", "minLength": 8},
          "stateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "resource", "fieldMask", "body"],
        "properties": {
          "method": {"enum": ["POST", "PATCH", "PUT", "FILE_PATCH"]},
          "resource": {"type": "string", "minLength": 1},
          "fieldMask": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "body": {"type": "object", "$ref": "#/$defs/safeValue"}
        }
      }
    },
    "expectedReadback": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

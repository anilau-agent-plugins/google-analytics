{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anilau:google-analytics:report:v1",
  "title": "Google Analytics Advisor report",
  "$defs": {
    "safeValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "propertyNames": {"pattern": "^(?!.*(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])(?:[Vv][Aa][Ll][Uu][Ee])?$).*$"}, "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "generatedAt", "reportId", "property", "timezone", "currency", "periods", "queries", "facts", "calculations", "interpretations", "limitations", "recommendations", "questions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "report"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "reportId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "property": {"type": "string", "pattern": "^properties/[0-9]+$"},
    "timezone": {"type": "string", "minLength": 1},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "from", "to", "complete"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "from": {"type": "string", "format": "date"},
          "to": {"type": "string", "format": "date"},
          "complete": {"type": "boolean"}
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "method", "apiChannel", "requestId", "filters", "returnPropertyQuota", "responseMetadata"],
        "properties": {
          "provider": {"enum": ["analytics-data", "analytics-admin", "tag-manager", "website"]},
          "method": {"type": "string", "minLength": 1},
          "apiChannel": {"type": "string", "minLength": 1},
          "requestId": {"type": "string", "minLength": 1},
          "filters": {"type": "object", "$ref": "#/$defs/safeValue"},
          "returnPropertyQuota": {"type": "boolean"},
          "responseMetadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sampled", "thresholded", "dataLossFromOtherRow", "quota"],
            "properties": {
              "sampled": {"enum": [true, false, "unknown"]},
              "thresholded": {"enum": [true, false, "unknown"]},
              "dataLossFromOtherRow": {"enum": [true, false, "unknown"]},
              "quota": {"oneOf": [{"type": "null"}, {"type": "object", "$ref": "#/$defs/safeValue"}]}
            }
          }
        }
      }
    },
    "facts": {"type": "array", "items": {"type": "object", "required": ["statement", "source"], "properties": {"statement": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "calculations": {"type": "array", "items": {"type": "object", "required": ["name", "formula", "result"], "properties": {"name": {"type": "string"}, "formula": {"type": "string"}, "result": {"type": ["string", "number", "null"]}}, "additionalProperties": false}},
    "interpretations": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "object", "required": ["type", "message"], "properties": {"type": {"enum": ["sampling", "thresholding", "cardinality", "quota", "incomplete-period", "compatibility", "small-data", "other"]}, "message": {"type": "string"}}, "additionalProperties": false}},
    "recommendations": {"type": "array", "items": {"type": "object", "required": ["priority", "action", "evidence", "benefit", "effort", "risk", "verification"], "properties": {"priority": {"type": "integer", "minimum": 1}, "action": {"type": "string"}, "evidence": {"type": "string"}, "benefit": {"type": "string"}, "effort": {"enum": ["low", "medium", "high"]}, "risk": {"enum": ["low", "medium", "high"]}, "verification": {"type": "string"}}, "additionalProperties": false}},
    "questions": {"type": "array", "items": {"type": "string"}}
  }
}
